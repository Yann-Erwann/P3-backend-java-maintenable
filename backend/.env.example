# Configuration locale commune à Docker Compose et au backend.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=chatop
MYSQL_USER=chatop
MYSQL_PASSWORD=change-me-local-app
MYSQL_ROOT_PASSWORD=change-me-local-root

# Générer avec openssl rand -base64 32. Ne pas versionner la clé réelle.
JWT_SECRET=
JWT_TTL=PT1H
# Reconstruire le frontend après une bascule : mock ou backend.
API_MODE=mock

# Hors Docker. Docker utilise le volume rental_images sur /app/uploads.
UPLOAD_DIR=./uploads
